#!/usr/bin/env bash
# TouchWorkstation's xdg-open shim.
#
# Installed to a PRIVATE directory (/opt/touchworkstation/bin), NOT to
# /usr/local/bin — so it does NOT shadow the system xdg-open (from xdg-utils).
# The real desktop and every other app keep their normal xdg-open behaviour.
#
# TouchWorkstation puts /opt/touchworkstation/bin first on PATH (and points
# $BROWSER here) ONLY for the processes it spawns — its phone-driven terminal
# and agent sessions (see twPath()/SPAWN_ENV in server/index.js and
# augmentPath() in server/pty.js). Inside those sessions, when a CLI tool
# (gh auth login, a dev server's "opening browser…", anything respecting
# $BROWSER or calling xdg-open) tries to open a local GUI browser — which
# nobody can see, since the machine is being driven from a phone — this prints
# the URL in a fixed, recognizable format instead. TerminalPTY.jsx /
# MinimalTerminalPTY.jsx catch it and offer to open it on the actual device.
echo "TOUCHWORKSTATION_OPEN_URL: $1"
