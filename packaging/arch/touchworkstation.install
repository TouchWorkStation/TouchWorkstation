# Arch's stock /etc/nginx/nginx.conf does NOT `include /etc/nginx/conf.d/*.conf;`
# (unlike Debian/Fedora), so the reverse-proxy drop-in this package installs at
# /etc/nginx/conf.d/touchworkstation.conf is silently ignored — nginx runs but
# nothing listens on :8088, and the app looks "active but unreachable". Ensure
# the include exists (idempotent), so the :8088 proxy actually loads.
ensure_nginx_confd_include() {
  NGINX_CONF=/etc/nginx/nginx.conf
  [ -f "$NGINX_CONF" ] || return 0
  # Already including conf.d (uncommented) anywhere? Nothing to do.
  if grep -Eq '^[[:space:]]*include[[:space:]]+.*conf\.d/\*\.conf;' "$NGINX_CONF"; then
    return 0
  fi
  cp -a "$NGINX_CONF" "${NGINX_CONF}.touchworkstation.bak" 2>/dev/null || true
  if grep -Eq '^[[:space:]]*#[[:space:]]*include[[:space:]]+.*conf\.d/\*\.conf;' "$NGINX_CONF"; then
    # Uncomment an existing commented-out include.
    sed -i -E '0,/^[[:space:]]*#[[:space:]]*(include[[:space:]]+.*conf\.d\/\*\.conf;)/s//    \1/' "$NGINX_CONF"
  else
    # Insert the include right after the first `http {`.
    sed -i '0,/^[[:space:]]*http[[:space:]]*{/s//&\n    include \/etc\/nginx\/conf.d\/*.conf; # added by touchworkstation/' "$NGINX_CONF"
  fi
  echo "==> Enabled /etc/nginx/conf.d/*.conf in nginx.conf (needed for the :8088 proxy)."
}
# If a firewall is active, allow the app's ports and trust the Tailscale
# interface. Without this the app serves fine on the host but is unreachable
# from any other device — LAN AND Tailscale alike — because the default INPUT
# policy drops inbound (reported on Omarchy, which ships ufw active). Only opens
# an already-active firewall; never installs or enables one.
open_firewall() {
  if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -qi '^Status: active'; then
    ufw allow 80/tcp   >/dev/null 2>&1 || true
    ufw allow 8088/tcp >/dev/null 2>&1 || true
    ufw allow 8787/tcp >/dev/null 2>&1 || true
    ufw allow in on tailscale0 >/dev/null 2>&1 || true
    ufw reload >/dev/null 2>&1 || true
    echo "==> Opened ufw for ports 80/8088/8787 and the Tailscale interface."
  elif command -v firewall-cmd >/dev/null 2>&1 && firewall-cmd --state 2>/dev/null | grep -q running; then
    for p in 80 8088 8787; do firewall-cmd --permanent --add-port="${p}/tcp" >/dev/null 2>&1 || true; done
    firewall-cmd --permanent --zone=trusted --add-interface=tailscale0 >/dev/null 2>&1 || true
    firewall-cmd --reload >/dev/null 2>&1 || true
    echo "==> Opened firewalld for ports 80/8088/8787 and the Tailscale interface."
  fi
}
# Enable + (re)start nginx with a config check. Uses restart, not reload, since
# we may have just changed the top-level nginx.conf (a reload can miss that).
start_nginx() {
  systemctl enable nginx 2>/dev/null || true
  if nginx -t 2>/dev/null; then
    systemctl restart nginx 2>/dev/null || systemctl start nginx 2>/dev/null || true
  else
    echo "WARNING: nginx -t failed; not restarting nginx. Check /etc/nginx/nginx.conf (a backup is at /etc/nginx/nginx.conf.touchworkstation.bak)." >&2
    systemctl start nginx 2>/dev/null || true
  fi
}

post_install() {
  APP=/opt/touchworkstation/app
  ENV_DIR=/etc/touchworkstation
  ENV_FILE=$ENV_DIR/touchworkstation.env
  STATE=/var/lib/touchworkstation

  APP_USER="$(getent passwd | awk -F: '$3>=1000 && $3<60000 && $7 !~ /(nologin|false)$/ {print $1; exit}')"
  if [ -z "$APP_USER" ]; then
    echo "==> Could not auto-detect a normal user account."
    echo "    Edit /usr/lib/systemd/system/touchworkstation.service yourself:"
    echo "    replace TW_USER_PLACEHOLDER / TW_GROUP_PLACEHOLDER with your username/group."
    APP_USER=root
  fi
  APP_GROUP=$(id -gn "$APP_USER" 2>/dev/null || echo "$APP_USER")
  APP_HOME=$(getent passwd "$APP_USER" | cut -d: -f6)

  mkdir -p "$ENV_DIR" "$STATE" "$APP_HOME/TouchWorkstation/Projects" "$APP_HOME/.local/share/touchworkstation"

  # Reconcile the env file instead of only writing it when absent. A leftover
  # file from a failed or older install (even a partially-run website install)
  # otherwise survives untouched, and if its temporary password isn't the
  # documented `touchwork` — older builds generated a random one — the user
  # can't log in with the password this installer prints. A password the user
  # has actually chosen (first-login completed → PW_MUST_CHANGE=0) is always
  # preserved; while PW_MUST_CHANGE is still 1 the stored value is only a
  # temporary first-run password, so reset it to `touchwork` to keep the
  # one-line install deterministic. JWT_SECRET is preserved once it exists.
  OLD_PASSWORD=""; OLD_SECRET=""; OLD_MUST_CHANGE=""
  if [ -f "$ENV_FILE" ]; then
    OLD_PASSWORD=$(grep '^APP_PASSWORD=' "$ENV_FILE" | head -1 | cut -d= -f2- || true)
    OLD_SECRET=$(grep '^JWT_SECRET=' "$ENV_FILE" | head -1 | cut -d= -f2- || true)
    OLD_MUST_CHANGE=$(grep '^PW_MUST_CHANGE=' "$ENV_FILE" | head -1 | cut -d= -f2- || true)
  fi
  if [ "$OLD_MUST_CHANGE" = "0" ] && [ -n "$OLD_PASSWORD" ]; then
    APP_PASSWORD="$OLD_PASSWORD"; PW_MUST_CHANGE=0
  else
    APP_PASSWORD=touchwork; PW_MUST_CHANGE=1
  fi
  JWT_SECRET="${OLD_SECRET:-$(openssl rand -hex 48)}"
  cat > "$ENV_FILE" <<ENV
APP_PASSWORD=$APP_PASSWORD
JWT_SECRET=$JWT_SECRET
PW_MUST_CHANGE=$PW_MUST_CHANGE
PORT=8787
TW_USER=$APP_USER
TW_HOME=$APP_HOME
TW_STATE_DIR=$APP_HOME/.local/share/touchworkstation
TW_ENV_FILE=$ENV_FILE
TW_BIN=/opt/touchworkstation/bin
HOME=$APP_HOME
ENV
  chown root:"$APP_GROUP" "$ENV_FILE"; chmod 660 "$ENV_FILE"

  chown -R "$APP_USER:$APP_GROUP" "$APP_HOME/.local" "$STATE" "$APP_HOME/TouchWorkstation" "$APP" 2>/dev/null || true

  sed -i "s/^User=TW_USER_PLACEHOLDER/User=$APP_USER/; s/^Group=TW_GROUP_PLACEHOLDER/Group=$APP_GROUP/" \
    /usr/lib/systemd/system/touchworkstation.service

  # Actually bring the services up instead of printing a command the user has
  # to remember — nginx (the :8088 proxy) staying down was reported as "the
  # app isn't reachable on its port". nginx is a hard dependency so it's
  # present; enable+start both, and validate the config before (re)loading it.
  systemctl daemon-reload 2>/dev/null || true
  systemctl enable --now touchworkstation 2>/dev/null || true
  ensure_nginx_confd_include
  start_nginx
  # Tailscale is a dependency now; bring its daemon up so the in-app "remote
  # access" flow only has to run `tailscale up` (sign in), not install/enable it.
  systemctl enable --now tailscaled 2>/dev/null || true
  open_firewall

  echo
  echo "============================================================"
  echo " TouchWorkstation installed and started."
  echo
  echo " Open: http://$(hostname).local:8088"
  IP=$(hostname -I 2>/dev/null | awk '{print $1}')
  [ -n "$IP" ] && echo " Or:   http://${IP}:8088"
  if [ "$PW_MUST_CHANGE" = "1" ]; then
    echo " Beta password: $APP_PASSWORD (you'll be asked to change it on first login)"
  else
    echo " Log in with the password you already set."
  fi
  echo " Manage it with:  touchworkstation status | restart | url"
  echo "============================================================"
}

post_upgrade() {
  # Re-apply the user/group substitution — pacman replaces the unit file
  # with the fresh placeholder version on every upgrade.
  ENV_FILE=/etc/touchworkstation/touchworkstation.env
  # If first-login was never completed (PW_MUST_CHANGE=1), the stored password
  # is just a temporary first-run value and may not be the documented
  # `touchwork` (an older/failed install could have left a random one). Reset
  # it so re-running the installer recovers a known first-run password. A
  # password the user has set (PW_MUST_CHANGE=0) is left untouched.
  if grep -q '^PW_MUST_CHANGE=1' "$ENV_FILE" 2>/dev/null; then
    sed -i 's/^APP_PASSWORD=.*/APP_PASSWORD=touchwork/' "$ENV_FILE"
  fi
  APP_USER=$(grep '^TW_USER=' "$ENV_FILE" 2>/dev/null | cut -d= -f2-)
  [ -n "$APP_USER" ] || return 0
  APP_GROUP=$(id -gn "$APP_USER" 2>/dev/null || echo "$APP_USER")
  sed -i "s/^User=TW_USER_PLACEHOLDER/User=$APP_USER/; s/^Group=TW_GROUP_PLACEHOLDER/Group=$APP_GROUP/" \
    /usr/lib/systemd/system/touchworkstation.service
  chown -R "$APP_USER:$APP_GROUP" /opt/touchworkstation/app 2>/dev/null || true
  # Migrate the xdg-open shim off /usr/local/bin (which shadowed the system
  # xdg-open for the WHOLE machine) to a private dir the app scopes to its own
  # spawned sessions. Remove our old system-wide shim, drop the old BROWSER
  # line, and make sure TW_BIN points at the new private dir.
  if [ -f /usr/local/bin/xdg-open ] && grep -q TOUCHWORKSTATION_OPEN_URL /usr/local/bin/xdg-open 2>/dev/null; then
    rm -f /usr/local/bin/xdg-open
  fi
  sed -i '\#^BROWSER=/usr/local/bin/xdg-open#d' "$ENV_FILE" 2>/dev/null || true
  grep -q '^TW_BIN=' "$ENV_FILE" 2>/dev/null || echo 'TW_BIN=/opt/touchworkstation/bin' >> "$ENV_FILE"
  # A rebuilt bundle on disk doesn't do anything on its own — Node keeps
  # running whatever code was already loaded in memory until the process
  # restarts. Without this, every upgrade silently kept serving the old
  # backend (new frontend static files WOULD still be picked up fresh since
  # nothing caches those in-process, but any server-side change — new API
  # fields, new routes — just never took effect no matter how many times
  # you reinstalled).
  systemctl daemon-reload
  systemctl stop touchworkstation 2>/dev/null || true
  # Belt-and-suspenders: if anything else (a manual `node server/index.js`,
  # an old crashed run that never fully exited) is squatting on the port,
  # the freshly-restarted service fails on EADDRINUSE and systemd just
  # crash-loops it forever — the upgrade "worked" but silently never took
  # effect no matter how many times it's reinstalled, because the running
  # process was never actually replaced. The .deb installer already guards
  # against this; the Arch package never did.
  fuser -k 8787/tcp 2>/dev/null || true
  systemctl enable touchworkstation 2>/dev/null || true
  if ! systemctl restart touchworkstation; then
    echo "WARNING: TouchWorkstation did not restart automatically — run: sudo systemctl restart touchworkstation" >&2
  fi
  # Make sure the :8088 proxy is up too — earlier packages never enabled or
  # started nginx on upgrade, so it could sit inactive (reported: nginx
  # inactive, app not reachable on 8088). Also repair the conf.d include for
  # machines installed before this fix existed.
  ensure_nginx_confd_include
  start_nginx
  systemctl enable --now tailscaled 2>/dev/null || true
  open_firewall
  echo "==> Updated and restarted (app + nginx)."
}

pre_remove() {
  systemctl stop touchworkstation 2>/dev/null || true
  systemctl disable touchworkstation 2>/dev/null || true
}
