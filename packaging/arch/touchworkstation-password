#!/usr/bin/env bash
set -euo pipefail
[ "$EUID" -eq 0 ] || { echo 'Run with sudo.'; exit 1; }
ENV=/etc/touchworkstation/touchworkstation.env
if [ $# -gt 0 ]; then NEW="$1"; else read -rsp 'New TouchWorkstation password: ' NEW; echo; fi
[ ${#NEW} -ge 8 ] || { echo 'Use at least 8 characters.'; exit 1; }
python3 - "$ENV" "$NEW" <<'PY'
import sys
p,v=sys.argv[1:]
lines=open(p).read().splitlines()
out=[]
for line in lines:
    out.append('APP_PASSWORD='+v if line.startswith('APP_PASSWORD=') else line)
open(p,'w').write('\n'.join(out)+'\n')
PY
systemctl restart touchworkstation
echo 'Password updated.'
